# DeepSonar 官方深度二进制解析运行时。project opt-in。
# 从 deepsonar-base 派生：钉死 rea-agents@6.4.0 + Ghidra 12.1.4 + 完整 64 位 JDK 21。
# CLI-only：复用 Agent Shell / Job / Evidence；不注册 MCP、不安装 Hopper/IDA、不启常驻 REA 服务。
# 不改变全局默认镜像；不把 Ghidra 塞进 deepsonar-mobile。
ARG BASE_IMAGE=deepsonar-base:local
ARG JDK21_IMAGE=eclipse-temurin:21-jdk@sha256:3e3c176ffed168beb42c607be9bc1639b466cf00261a0fb04425562c9d0c5c2b

FROM ${JDK21_IMAGE} AS jdk21
FROM ${BASE_IMAGE} AS runtime-rootfs

USER root
ARG TARGETARCH
ARG REA_AGENTS_VERSION=6.4.0
ARG REA_AGENTS_INTEGRITY=sha512-Vj1zWfSlna5bphGoaoI/TcVBuYvze9u+OyPC3Shz8YkBqaCTqB4COnnRoX7XDwMpwI24ZlFEel2yEj0k8LTWEQ==
ARG REA_AGENTS_GIT_HEAD=a56f7bb668ab23fec8d33f7af353ac7ed2fe1895
ARG GHIDRA_VERSION=12.1.4
ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip
ARG GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db
ARG NODE_MIN_VERSION=22.19.0

COPY --from=jdk21 /opt/java/openjdk /opt/deepsonar/jdks/21
COPY deploy/reverse-env.sh /tmp/reverse-env.sh

RUN set -eux; \
  apt-get -o Acquire::Retries=3 update; \
  apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    ca-certificates curl unzip xz-utils fontconfig libfreetype6; \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/locale/*; \
  install -d -m 0755 \
    /opt/deepsonar/bin \
    /opt/deepsonar/ghidra \
    /opt/deepsonar/rea \
    /opt/deepsonar/jdks/21; \
  node -e 'const min=process.argv[1].split(".").map(Number); const cur=process.versions.node.split(".").map(Number); for (let i=0;i<3;i++){ if((cur[i]||0)>(min[i]||0)) process.exit(0); if((cur[i]||0)<(min[i]||0)){ console.error("Node "+process.versions.node+" < "+process.argv[1]); process.exit(1);} }' \
    "$NODE_MIN_VERSION"; \
  test -x /opt/deepsonar/jdks/21/bin/java; \
  /opt/deepsonar/jdks/21/bin/java -version 2>&1 | head -n1 | grep -E 'version "21[\."]' >/dev/null; \
  ghidra_zip="/tmp/ghidra_${GHIDRA_VERSION}.zip"; \
  curl -fsSL --retry 5 --retry-all-errors --connect-timeout 30 \
    "$GHIDRA_URL" -o "$ghidra_zip"; \
  echo "$GHIDRA_SHA256  $ghidra_zip" | sha256sum -c -; \
  unzip -q "$ghidra_zip" -d /tmp; \
  ghidra_dir="$(find /tmp -maxdepth 1 -type d -name 'ghidra_*PUBLIC*' | head -n1)"; \
  test -n "$ghidra_dir"; \
  test -x "$ghidra_dir/support/analyzeHeadless"; \
  case "$TARGETARCH" in \
    amd64) decomp_os=linux_x86_64 ;; \
    arm64) decomp_os=linux_arm_64 ;; \
    *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
  esac; \
  decomp_bin="$(find "$ghidra_dir/Ghidra/Features/Decompiler" -type f -path "*/os/${decomp_os}/decompile" | head -n1)"; \
  test -n "$decomp_bin" && test -x "$decomp_bin"; \
  mv "$ghidra_dir"/* /opt/deepsonar/ghidra/; \
  rmdir "$ghidra_dir" || true; \
  rm -f "$ghidra_zip"; \
  ln -sf /opt/deepsonar/ghidra/support/analyzeHeadless /opt/deepsonar/bin/analyzeHeadless; \
  test "$(npm view rea-agents@${REA_AGENTS_VERSION} dist.integrity)" = "$REA_AGENTS_INTEGRITY"; \
  test "$(npm view rea-agents@${REA_AGENTS_VERSION} gitHead)" = "$REA_AGENTS_GIT_HEAD"; \
  npm install --omit=dev --no-audit --no-fund --prefix /opt/deepsonar/rea \
    rea-agents@${REA_AGENTS_VERSION}; \
  test "$(node -e 'process.stdout.write(require("/opt/deepsonar/rea/node_modules/rea-agents/package.json").version)')" = "$REA_AGENTS_VERSION"; \
  ln -sf /opt/deepsonar/rea/node_modules/rea-agents/scripts/rea.mjs /opt/deepsonar/bin/rea; \
  ln -sf /opt/deepsonar/rea/node_modules/rea-agents/scripts/rea.mjs /opt/deepsonar/bin/rea-agents; \
  chmod 0755 /opt/deepsonar/bin/rea /opt/deepsonar/bin/rea-agents; \
  install -m 0755 /tmp/reverse-env.sh /opt/deepsonar/bin/reverse-env.sh; \
  rm -f /tmp/reverse-env.sh; \
  npm cache clean --force; \
  if ! getent group deepsonar >/dev/null; then groupadd --gid 1001 deepsonar; fi; \
  if ! id deepsonar >/dev/null 2>&1; then useradd --uid 1001 --gid deepsonar --create-home --shell /bin/bash deepsonar; fi; \
  node -e 'const fs=require("node:fs"); const m={contract:"deepsonar.runtime.contract/v1",toolset:"reverse",imageKey:"deepsonar-reverse",project_opt_in:true,tools:["java","javac","rea","rea-agents","analyzeHeadless","jq","node","claude"],ghidra:{version:"12.1.4",install_dir:"/opt/deepsonar/ghidra",analyze_headless:"/opt/deepsonar/ghidra/support/analyzeHeadless"},rea:{version:"6.4.0",gitHead:"a56f7bb668ab23fec8d33f7af353ac7ed2fe1895",integrity:"sha512-Vj1zWfSlna5bphGoaoI/TcVBuYvze9u+OyPC3Shz8YkBqaCTqB4COnnRoX7XDwMpwI24ZlFEel2yEj0k8LTWEQ==",cli_only:true,mcp:false},jdk:{major:"21",home:"/opt/deepsonar/jdks/21"},entrypoints:{check:"/opt/deepsonar/bin/reverse-env.sh"},not_included:["mcp","hopper","ida","resident-rea-service"]}; fs.writeFileSync("/opt/deepsonar/tool-manifest.json",JSON.stringify(m,null,2)+"\n")'; \
  chown -R deepsonar:deepsonar /opt/deepsonar /workspace; \
  JAVA_HOME=/opt/deepsonar/jdks/21 \
  GHIDRA_INSTALL_DIR=/opt/deepsonar/ghidra \
  PATH="/opt/deepsonar/bin:/opt/deepsonar/jdks/21/bin:$PATH" \
    /opt/deepsonar/bin/reverse-env.sh --check

COPY agent-harness/runtime-manuals /opt/deepsonar/runtime-manuals
COPY agent-harness/materialize-runtime-manuals.mjs /opt/deepsonar/materialize-runtime-manuals.mjs
RUN node /opt/deepsonar/materialize-runtime-manuals.mjs \
  --catalog /opt/deepsonar/runtime-manuals/catalog.json \
  --source-root /opt/deepsonar/runtime-manuals \
  --tool-manifest /opt/deepsonar/tool-manifest.json \
  --output /opt/deepsonar/manuals \
  --image-key deepsonar-reverse \
  && rm -rf /opt/deepsonar/runtime-manuals /opt/deepsonar/materialize-runtime-manuals.mjs

ENV IS_SANDBOX=1 \
    JAVA_HOME=/opt/deepsonar/jdks/21 \
    GHIDRA_INSTALL_DIR=/opt/deepsonar/ghidra \
    PATH=/opt/deepsonar/bin:/opt/deepsonar/jdks/21/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace

FROM scratch
ARG OCI_TITLE="DeepSonar Reverse"
ARG OCI_DESCRIPTION="Project-opt-in deep native binary analysis runtime: pinned REA CLI 6.4.0 + Ghidra 12.1.4 + full JDK 21. CLI-only; no MCP, Hopper, IDA, or resident REA service. Not the global default."
LABEL io.deepsonar.contract="deepsonar.runtime.contract/v1" \
      io.deepsonar.toolset="reverse" \
      io.deepsonar.image-key="deepsonar-reverse" \
      io.deepsonar.tools-manifest="/opt/deepsonar/tool-manifest.json" \
      io.deepsonar.manuals="/opt/deepsonar/manuals/index.json" \
      org.opencontainers.image.title="${OCI_TITLE}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      org.opencontainers.image.source="https://github.com/SummerSec/DeepSonar" \
      org.opencontainers.image.documentation="https://github.com/SummerSec/DeepSonar/blob/main/docs/RELEASE_RUNTIME_IMAGES.md" \
      org.opencontainers.image.licenses="LicenseRef-DeepSonar-Proprietary"
ENV IS_SANDBOX=1 \
    JAVA_HOME=/opt/deepsonar/jdks/21 \
    GHIDRA_INSTALL_DIR=/opt/deepsonar/ghidra \
    PATH=/opt/deepsonar/bin:/opt/deepsonar/jdks/21/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=runtime-rootfs / /
WORKDIR /workspace
USER deepsonar
CMD ["sleep", "infinity"]
